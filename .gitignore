# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
/build
dist/
**/dist/

# protocol dev keys (local fallback)
.data/

# misc
.DS_Store
*.pem
*.p12
*.pfx
__pycache__/
*.py[cod]
packages/auros-protocol-python/dist/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env — never commit secrets (keep .env.example only)
.env
.env.*
!.env.example
!.env*.example

# local data / signing / alert stores
.data/
**/.data/

# vercel / local dumps
.vercel
.vercel-*
.env.vercel*
*.vercel.json.bak
vercel-env*.txt
vercel-env*.json

# scratch / scrape / dumps
tmp/
tmp-*
tmp*.json
*.dump
*.dump.sql
*-prod.html
*-tmp.html
*-scrape.html
compare.html
compare-tmp.html
dashboard-prod.html
est-prod.html
green.html
how-prod.html
trust-prod.html
scripts/tmp-*
docs/GITHUB_SSH_PUBLIC_KEY.txt

# typescript
*.tsbuildinfo
next-env.d.ts
